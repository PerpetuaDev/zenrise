# Copy to relay/.env and fill in — .env is gitignored, never commit it.
MAILGUN_API_KEY=
# sandboxXXXX.mailgun.org until mg.zenrise.jp is verified
MAILGUN_DOMAIN=
# us or eu — check whether the console lives at app.mailgun.com or app.eu.mailgun.com
MAILGUN_REGION=us
# where booking notifications go (must be an authorized recipient while on the sandbox)
NOTIFY_TO=
REPLY_TO=hello@zenrise.jp
# Cloudflare Turnstile. Secret half of the widget on contact.html --
# get it from the Turnstile dashboard, never from the page.
TURNSTILE_SECRET=
# Hostnames siteverify must report back. Deployment-specific: a production
# relay must NOT list localhost, or a token minted locally would be accepted.
TURNSTILE_HOSTNAMES=zenrise.jp,www.zenrise.jp
